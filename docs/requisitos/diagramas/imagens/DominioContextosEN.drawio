<mxfile host="drawio"><diagram id="DominioContextosEN" name="DominioContextosEN"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="k0" value="&lt;b&gt;Membership (3.1)&lt;/b&gt;&lt;br&gt;&lt;br&gt;FAIR (platform) · AMAP · AMAP rules · Person · Membership (role, status)&lt;br&gt;Consent · Withdrawal request&lt;br&gt;Producer application · Farm visit" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#262626;strokeColor=#D6615C;strokeWidth=2;fillColor=#FDF1F0;" vertex="1" parent="1"><mxGeometry x="320" y="40" width="480" height="120" as="geometry"/></mxCell><mxCell id="k1" value="&lt;b&gt;Catalogue and subscriptions (3.2, 3.3)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Producer profile · Product · Variant&lt;br&gt;Cycle · Offer · Subscription · Subscription line&lt;br&gt;Exclusion" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#262626;strokeColor=#D6615C;strokeWidth=2;fillColor=#FFF6E8;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="480" height="120" as="geometry"/></mxCell><mxCell id="k2" value="&lt;b&gt;Deliveries (3.4)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Delivery date · Delivery · Delivered item&lt;br&gt;Missing item · Absence · Collection · Bag label" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#262626;strokeColor=#D6615C;strokeWidth=2;fillColor=#EEF5EC;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="480" height="120" as="geometry"/></mxCell><mxCell id="k3" value="&lt;b&gt;Payments (3.5)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Payment rules · Payment request&lt;br&gt;Producer share · Payment · FAIR charge" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontColor=#262626;strokeColor=#D6615C;strokeWidth=2;fillColor=#E