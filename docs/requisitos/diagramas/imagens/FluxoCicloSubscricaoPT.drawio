"/></mxCell><mxCell id="s" value="" style="ellipse;html=1;shape=startState;fillColor=#262626;strokeColor=#262626;" vertex="1" parent="1"><mxGeometry x="150.0" y="115.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a1" value="Preparar catálogo e datas de entrega&lt;br&gt;(reutilizar o ciclo anterior)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65.0" y="193.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a2" value="Abrir ciclo: duração e&lt;br&gt;prazo de subscrição" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315.0" y="285.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a3" value="Avisar os membros ativos" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="377.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a4" value="Escolher produtos, variantes e&lt;br&gt;datas de vários produtores;&lt;br&gt;registar exclusões" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815.0" y="469.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="d1" value="Há&lt;br&gt;vagas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#E17E00;fontColor=#262626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835.0" y="551.0" width="160" height="78" as="geometry"/></mxCell><mxCell id="a5" value="Colocar em lista de espera&lt;br&gt;(FR-14)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="653.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="e1" value="Em lista de espera" style="ellipse;html=1;shape=endState;fillColor=#262626;strokeColor=#262626;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#262626;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="400.0" y="667.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="d2" value="Dentro do&lt;br&gt;prazo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#E17E00;fontColor=#262626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835.0" y="735.0" width="160" height="78" as="geometry"/></mxCell><mxCell id="d3" value="Gestão&lt;br&gt;aprova?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#E17E00;fontColor=#262626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335.0" y="827.0" width="160" height="78" as="geometry"/></mxCell><mxCell id="e2" value="Pedido recusado" style="ellipse;html=1;shape=endState;fillColor=#262626;strokeColor=#262626;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#262626;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="150.0" y="851.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a7" value="Registar subscrição, enviar confirmação,&lt;br&gt;atualizar totais dos produtores e&lt;br&gt;agendar pedidos de pagamento (3.5)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="837.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a9" value="Planear produção e colheita&lt;br&gt;a partir dos totais encomendados" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65.0" y="1021.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a10" value="Alterar encomenda dentro das&lt;br&gt;regras de cada produtor (opcional)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColo