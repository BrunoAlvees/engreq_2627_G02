Dx=0;entryDy=0;" edge="1" parent="1" source="b9" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed14" value="sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="e2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed15" value="não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="b10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b10" target="b11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b11" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;Notas:&lt;/b&gt; FR-24 a FR-29 (funcionalidade 3.4) e FR-35 (lembrete). O botão na app é a forma essencial de confirmar; as etiquetas QR em folhas A4 são opcionais para produtores com impressora (E-8). O cabaz de um membro ausente é sempre levantado e pago (FR-27)." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=13;fillColor=#FFF8E6;strokeColor=#E17E00;fontColor=#262626;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="1622" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
