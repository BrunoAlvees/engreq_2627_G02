arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="745.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="b6" value="Atualizar a folha de distribuição;&lt;br&gt;avisar o produtor" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315.0" y="837.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="b7" value="Imprimir etiquetas (opcional) e&lt;br&gt;deixar os sacos no ponto de entrega" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65.0" y="929.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="b8" value="Levantar o cabaz e confirmar:&lt;br&gt;botão na app ou código QR" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="1021.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="b9" value="Registar o levantamento&lt;br&gt;(avisar se o saco não é seu)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315.0" y="1113.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="d4" value="Todos os cabazes&lt;br&gt;confirmados?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#E17E00;fontColor=#262626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="335.0" y="1195.0" width="160" height="78" as="geometry"/></mxCell><mxCell id="e2" value="Entrega fechada" style="ellipse;html=1;shape=endState;fillColor=#262626;strokeColor=#262626;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#262626;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="900.0" y="1219.0" widt