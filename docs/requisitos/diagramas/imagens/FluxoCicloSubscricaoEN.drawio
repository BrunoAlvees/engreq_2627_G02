l id="ed12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a7" target="a9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed13" value="during the cycle" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a9" target="a10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a10" target="a11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a11" target="d4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="e3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed17" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d4" target="a12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed18" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="a12" target="e4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="&lt;b&gt;Notes:&lt;/b&gt; FR-17 to FR-23 (feature 3.3). Renewal is an intention or a mandatory confirmation, as chosen by each AMAP (FR-22). Allergies are health data and need explicit consent (NFR-06). Payment follows each producer's rules (FR-30, FR-31)." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=13;fillColor=#FFF8E6;strokeColor=#E17E00;fontColor=#262626;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="1622" width="1000" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
