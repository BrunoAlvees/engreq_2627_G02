"/></mxCell><mxCell id="s" value="" style="ellipse;html=1;shape=startState;fillColor=#262626;strokeColor=#262626;" vertex="1" parent="1"><mxGeometry x="150.0" y="115.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a1" value="Prepare catalogue and delivery dates&lt;br&gt;(reuse previous cycle)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="65.0" y="193.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a2" value="Open cycle: length and&lt;br&gt;subscription deadline" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="315.0" y="285.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a3" value="Notify active members" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="377.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a4" value="Choose products, variants and&lt;br&gt;dates from several producers;&lt;br&gt;record exclusions" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815.0" y="469.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="d1" value="Places&lt;br&gt;available?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#E17E00;fontColor=#262626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835.0" y="551.0" width="160" height="78" as="geometry"/></mxCell><mxCell id="a5" value="Add to the waiting list&lt;br&gt;(FR-14)" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="653.0" width="200" height="58" as="geometry"/></mxCell><mxCell