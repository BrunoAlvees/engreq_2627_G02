26;fontSize=13;" vertex="1" parent="1"><mxGeometry x="815.0" y="1113.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="a11" value="Ask whether they renew,&lt;br&gt;with the previous order pre-filled" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="1205.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="d4" value="Renews?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#E17E00;fontColor=#262626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="835.0" y="1287.0" width="160" height="78" as="geometry"/></mxCell><mxCell id="e3" value="Next cycle" style="ellipse;html=1;shape=endState;fillColor=#262626;strokeColor=#262626;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#262626;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="900.0" y="1403.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="a12" value="Record it, notify management;&lt;br&gt;place offered to the waiting list" style="rounded=1;arcSize=18;whiteSpace=wrap;html=1;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="565.0" y="1389.0" width="200" height="58" as="geometry"/></mxCell><mxCell id="e4" value="Leaves at the end of the cycle" style="ellipse;html=1;shape=endState;fillColor=#262626;strokeColor=#262626;verticalLabelPosition=bottom;verticalAlign=top;fontSize=12;fontColor=#262626;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="650.0" y="1495.0" width="30" height="30" as="geometry"/></mxCell><mxCell id="ed0" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#595959;fontColor=#703E00;fontSize=12;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ed1