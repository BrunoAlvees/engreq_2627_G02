<mxfile host="drawio"><diagram id="rf07-en" name="RF07 Use cases"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="FAIR-AMAP" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;fillColor=#FAEDD9;strokeColor=#D6615C;fontColor=#262626;swimlaneFillColor=#FFFBF5;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="220" y="50" width="700" height="600" as="geometry"/></mxCell><mxCell id="u1" value="Sign up for a rota shift" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="40" width="270" height="60" as="geometry"/></mxCell><mxCell id="u2" value="Sign up for an event" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="130" width="270" height="60" as="geometry"/></mxCell><mxCell id="u3" value="Give feedback" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="220" width="270" height="60" as="geometry"/></mxCell><mxCell id="u4" value="Consult documents and rules" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="330" width="270" height="60" as="geometry"/></mxCell><mxCell id="u5" value="Publish document version" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="400" y="40" width="270" height="60" as="geometry"/></mxCell><mxCell id="u6" value="Manage working groups" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="400" y="130" width="270" height="60" as="geometry"/></mxCell><mxCell id="u7" value="Create d