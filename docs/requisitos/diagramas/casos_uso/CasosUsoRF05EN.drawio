eometry"/></mxCell><mxCell id="egu7" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aGEST" target="u7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="epu7" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="epu8" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="epu9" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x1" value="«include»" style="dashed=1;endArrow=open;html=1;strokeColor=#E17E00;fontColor=#703E00;fontSize=12;labelBackgroundColor=default;" edge="1" parent="sys" source="u2" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Notes:&lt;/b&gt; the system never holds the money: the licensed provider splits each payment among the producers (FR-32, NFR-19). Late payments are flagged in Track payments (FR-33). Weights recorded at delivery (FR-26, feature 3.4) go into the next payment request. Invoicing is out of scope (NFR-18). Dashed line: «include»." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=13;fillColor=#FFF8E6;strokeColor=#E17E00;fontColor=#262626;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="220" y="710" width="700" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
