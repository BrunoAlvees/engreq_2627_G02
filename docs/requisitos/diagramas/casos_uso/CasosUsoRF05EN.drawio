<mxfile host="drawio"><diagram id="rf05-en" name="RF05 Use cases"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="FAIR-AMAP" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;fillColor=#FAEDD9;strokeColor=#D6615C;fontColor=#262626;swimlaneFillColor=#FFFBF5;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="220" y="50" width="700" height="640" as="geometry"/></mxCell><mxCell id="u1" value="View amount due and history" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="50" width="260" height="60" as="geometry"/></mxCell><mxCell id="u2" value="Pay the period's amount" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="170" width="260" height="60" as="geometry"/></mxCell><mxCell id="u3" value="Calculate and send payment request" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="470" width="260" height="60" as="geometry"/></mxCell><mxCell id="u4" value="Calculate FAIR's charge" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="400" y="50" width="270" height="60" as="geometry"/></mxCell><mxCell id="u5" value="Record payment made outside the platform" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="400" y="150" width="270" height="60" as="geometry"/></mxCell><mxCell id="u6" value="Configure payment methods" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="400" y="250" width="270" height="60" as="geometr