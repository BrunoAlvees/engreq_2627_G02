<mxfile host="drawio"><diagram id="rf03-en" name="RF03 Use cases"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="FAIR-AMAP" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;fillColor=#FAEDD9;strokeColor=#D6615C;fontColor=#262626;swimlaneFillColor=#FFFBF5;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="200" y="50" width="660" height="560" as="geometry"/></mxCell><mxCell id="u1" value="Subscribe to a cycle" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="40" width="220" height="56" as="geometry"/></mxCell><mxCell id="u2" value="Record exclusions" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="120" width="220" height="56" as="geometry"/></mxCell><mxCell id="u3" value="Change order" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="200" width="220" height="56" as="geometry"/></mxCell><mxCell id="u4" value="View subscriptions" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="280" width="220" height="56" as="geometry"/></mxCell><mxCell id="u5" value="Renew subscription" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="30" y="360" width="220" height="56" as="geometry"/></mxCell><mxCell id="u6" value="Open cycle" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="400" y="40" width="230" height="56" as="geometry"/></mxCell><mxCell id="u7" value="Approve late request" style="ellipse;whiteS