x=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x1" value="«extend»" style="dashed=1;endArrow=open;html=1;strokeColor=#E17E00;fontColor=#703E00;fontSize=12;labelBackgroundColor=default;" edge="1" parent="sys" source="u2" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Notes:&lt;/b&gt; renewal starts from the previous order; each AMAP chooses intention or mandatory confirmation (FR-22). Requests after the deadline need management approval (FR-20). Allergies are health data (NFR-06). Payment is handled in feature 3.5, at the moment each producer chooses (FR-30). Dashed line: «extend»." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=13;fillColor=#FFF8E6;strokeColor=#E17E00;fontColor=#262626;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="200" y="630" width="660" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
