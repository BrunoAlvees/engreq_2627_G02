erticalLabelPosition=bottom;verticalAlign=top;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#262626;fontColor=#262626;labelPerimeter=1;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="30" height="60" as="geometry"/></mxCell><mxCell id="e1" style="endArrow=none;html=1;strokeColor=#262626;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aCOP" target="u1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="endArrow=none;html=1;strokeColor=#262626;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aCOP" target="u2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="endArrow=none;html=1;strokeColor=#262626;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aCOP" target="u3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" style="endArrow=none;html=1;strokeColor=#262626;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aCOP" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="endArrow=none;html=1;strokeColor=#262626;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aCOP" target="u5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aGEST" target="u6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aGEST" target="u7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" style="endArrow=none;html=1;strokeColor=#262626;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="aPROD" target="u11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="x1" value="«extend»" style="dashed=1;endArrow=open;html=1;strokeColor=#E17E00;fontColor=#703E00;fontSize=12;labelBackgroundColor=default;" edge="1" parent="sys" source="u5" target="u4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Notas:&lt;/b&gt; no fim do horário de distribuição, o sistema assinala os cabazes não confirmados e avisa o coprodutor e o produtor (FR-28). Imprimir as etiquetas com QR é opcional; sem elas, os coprodutores confirmam com um botão (E-8). Numa ausência, o cabaz é sempre levantado e pago (FR-27). Linha tracejada: «extend»." style="shape=note;whiteSpace=wrap;html=1;size=14;fontSize=13;fillColor=#FFF8E6;strokeColor=#E17E00;fontColor=#262626;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="200" y="630" width="660" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
