<mxfile host="drawio"><diagram id="rf04-en" name="RF04 Use cases"><mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="FAIR-AMAP" style="swimlane;startSize=30;html=1;fontSize=16;fontStyle=1;fillColor=#FAEDD9;strokeColor=#D6615C;fontColor=#262626;swimlaneFillColor=#FFFBF5;rounded=1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="200" y="50" width="660" height="560" as="geometry"/></mxCell><mxCell id="u1" value="View delivery calendar" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="20" y="40" width="250" height="56" as="geometry"/></mxCell><mxCell id="u2" value="View basket contents" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="20" y="120" width="250" height="56" as="geometry"/></mxCell><mxCell id="u3" value="Report absence" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="20" y="200" width="250" height="56" as="geometry"/></mxCell><mxCell id="u4" value="Confirm collection" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="20" y="280" width="250" height="56" as="geometry"/></mxCell><mxCell id="u5" value="Scan bag QR code" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="20" y="360" width="250" height="56" as="geometry"/></mxCell><mxCell id="u6" value="Set distribution place and time" style="ellipse;whiteSpace=wrap;html=1;fontSize=14;fillColor=#F6DFDE;strokeColor=#D6615C;fontColor=#262626;" vertex="1" parent="sys"><mxGeometry x="340" y="40" width="300" height="56" as="geometry"/></mxCell><mxCell id="u7" value="Confirm collectio